# Which Kalshi environment to trade against: "demo" or "prod"
KALSHI_ENV=demo

# From Account & security -> API Keys in the Kalshi UI
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Path to the RSA or Ed25519 private key PEM file downloaded when you created the API key.
# Keep this file OUTSIDE the repo. Never commit it.
KALSHI_PRIVATE_KEY_PATH=C:/secure/kalshi-key.pem

# Alternative to KALSHI_PRIVATE_KEY_PATH: paste the PEM contents directly (with \n for newlines).
# KALSHI_PRIVATE_KEY=

# Port the backend listens on
PORT=8787

# Origin the frontend is served from, for CORS. Comma-separate multiple origins.
WEB_ORIGIN=http://localhost:5173

# Cents added/subtracted from the best opposing price to make IOC orders marketable.
# e.g. 2 = pay up to 2 cents through the ask when buying, accept 2 cents through the bid when selling.
SLIPPAGE_BUFFER_CENTS=2
